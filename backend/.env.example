DATABASE_URL=sqlite:///./data/vast_news.db
# Local docker Postgres:
# DATABASE_URL=postgresql+psycopg2://vast:vast@localhost:5432/vast_news
# Neon (paste as-is; backend normalizes + adds sslmode if needed):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=http://localhost:3000
# Optional exact frontend URL after first deploy:
# CORS_ORIGINS=http://localhost:3000,https://vast-khcn-web.vercel.app
# Bootstrap-friendly: allow any *.vercel.app (default in code). Set empty to disable.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CRAWL_SCHEDULER_ENABLED=true
CRAWL_INTERVAL_SECONDS=300
CRAWL_ON_STARTUP=true
